# ─── ReportFlow Environment Variables Template ────────────────────────────────
# Copy this file to .env and fill in your credentials.
# In production (Vercel, Netlify, Cloudflare), configure these in your host dashboard.

# 1. Supabase Backend (Required)
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key"

# 2. Cloudflare R2 Remote Storage (Optional)
# If left blank, ReportFlow defaults to the Supabase Storage bucket ('report-attachments')
VITE_R2_UPLOAD_URL=""
VITE_R2_PUBLIC_URL=""
